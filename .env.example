PORT=5000
API_KEY=replace_with_a_long_random_secret
ADMIN_API_KEY=replace_with_a_different_long_random_secret
# Optional comma-separated browser origins; server-to-server calls need none.
CORS_ORIGIN=
DATABASE_URL=your_neon_postgresql_connection_string
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Must match vector(3072) in src/sql/init.sql.
EMBEDDING_DIMENSIONS=3072
